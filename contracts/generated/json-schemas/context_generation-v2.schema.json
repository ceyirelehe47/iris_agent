{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "iris.context_generation.v2",
  "title": "ContextGenerationV2",
  "type": "object",
  "properties": {
    "schemaId": {
      "const": "iris.context_generation.v2"
    },
    "header": {
      "type": "object",
      "properties": {
        "schemaId": {
          "const": "iris.context_generation_header.v1"
        },
        "contextGenerationId": {
          "type": "string",
          "minLength": 1
        },
        "contextLineageId": {
          "type": "string",
          "minLength": 1
        },
        "sourceSnapshotHash": {
          "type": "string",
          "minLength": 1
        },
        "layerEnds": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 6,
          "maxItems": 6
        },
        "contextGenerationHash": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "schemaId",
        "contextGenerationId",
        "contextLineageId",
        "sourceSnapshotHash",
        "layerEnds",
        "contextGenerationHash",
        "createdAt"
      ],
      "additionalProperties": false
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schemaId": {
            "const": "iris.context_unit.v2"
          },
          "header": {
            "type": "object",
            "properties": {
              "schemaId": {
                "const": "iris.context_unit_header.v1"
              },
              "contextUnitId": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "object",
                "properties": {
                  "schemaId": {
                    "const": "iris.context_unit_source_ref.v1"
                  },
                  "sourceSchemaId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sourceId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sourceRevision": {
                    "type": "string"
                  },
                  "sourceHash": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "schemaId",
                  "sourceSchemaId",
                  "sourceId",
                  "sourceHash"
                ],
                "additionalProperties": false
              },
              "semanticSchemaId": {
                "type": "string",
                "minLength": 1
              },
              "contentHash": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "schemaId",
              "contextUnitId",
              "source",
              "semanticSchemaId",
              "contentHash"
            ],
            "additionalProperties": false
          },
          "semanticContent": {
            "type": [
              "string",
              "number",
              "boolean",
              "null",
              "object",
              "array"
            ]
          }
        },
        "required": [
          "schemaId",
          "header",
          "semanticContent"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaId",
    "header",
    "units"
  ],
  "additionalProperties": false
}
