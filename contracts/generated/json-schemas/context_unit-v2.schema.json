{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "iris.context_unit.v2",
  "title": "ContextUnitV2",
  "type": "object",
  "properties": {
    "schemaId": {
      "const": "iris.context_unit.v2"
    },
    "header": {
      "type": "object",
      "properties": {
        "schemaId": {
          "const": "iris.context_unit_header.v1"
        },
        "contextUnitId": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "properties": {
            "schemaId": {
              "const": "iris.context_unit_source_ref.v1"
            },
            "sourceSchemaId": {
              "type": "string",
              "minLength": 1
            },
            "sourceId": {
              "type": "string",
              "minLength": 1
            },
            "sourceRevision": {
              "type": "string"
            },
            "sourceHash": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["schemaId", "sourceSchemaId", "sourceId", "sourceHash"],
          "additionalProperties": false
        },
        "semanticSchemaId": {
          "type": "string",
          "minLength": 1
        },
        "contentHash": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["schemaId", "contextUnitId", "source", "semanticSchemaId", "contentHash"],
      "additionalProperties": false
    },
    "semanticContent": {
      "type": ["string", "number", "boolean", "null", "object", "array"]
    }
  },
  "required": ["schemaId", "header", "semanticContent"],
  "additionalProperties": false
}
